# Copy this file to `.env` and replace the placeholder with your real values.

# Database (Neon PostgreSQL 18)
DATABASE_URL="postgresql://user:***@localhost:5432/mydb?sslmode=require"
DIRECT_URL="postgresql://user:***@localhost:5432/mydb?sslmode=require"

# JWT Secrets
JWT_ACCESS_SECRET="replace-with-a-strong-random-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-another-strong-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Resend (Email)
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Faktura <noreply@faktura.muhamadrizky.my.id>"

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"

# Vercel Blob (File Storage)
BLOB_READ_WRITE_TOKEN="vercel_blob_xxx"

# Midtrans
MIDTRANS_SERVER_KEY="your-midtrans-server-key"

# Internal Cron Secret (GitHub Actions)
INTERNAL_CRON_SECRET="replace-with-random-secret-for-cron"


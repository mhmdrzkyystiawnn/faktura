// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  passwordHash   String?   @map("password_hash")
  oauthProvider  String?   @map("oauth_provider")
  oauthId        String?   @unique @map("oauth_id")
  plan           String    @default("free") @map("plan")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  clients       Client[]
  invoices      Invoice[]
  subscriptions Subscription?
  refreshTokens RefreshToken[]
  passwordResets PasswordReset[]
  emailVerifications EmailVerification[]

  @@map("users")
}

model Client {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([userId])
  @@map("clients")
}

model Invoice {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  clientId      String   @map("client_id")
  invoiceNumber String   @unique @map("invoice_number")
  status        String   @default("draft") @map("status")
  issueDate     DateTime @map("issue_date")
  dueDate       DateTime @map("due_date")
  subtotal      Decimal  @db.Decimal(14, 2) @map("subtotal")
  taxPercent    Decimal  @default(0) @db.Decimal(5, 2) @map("tax_percent")
  discountAmount Decimal @default(0) @db.Decimal(14, 2) @map("discount_amount")
  total         Decimal  @db.Decimal(14, 2) @map("total")
  currency      String   @default("IDR") @map("currency")
  publicToken   String   @unique @map("public_token")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id])
  client   Client        @relation(fields: [clientId], references: [id])
  items    InvoiceItem[]
  payments Payment[]
  reminders Reminder[]

  @@index([userId, status])
  @@index([publicToken])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  description String   @map("description")
  quantity    Decimal  @default(1) @db.Decimal(10, 2) @map("quantity")
  unitPrice   Decimal  @db.Decimal(14, 2) @map("unit_price")
  subtotal    Decimal  @db.Decimal(14, 2) @map("subtotal")
  sortOrder   Int      @default(0) @map("sort_order")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id               String   @id @default(uuid())
  invoiceId        String   @map("invoice_id")
  amount           Decimal  @db.Decimal(14, 2) @map("amount")
  method           String   @map("method")
  gatewayReference String?  @unique @map("gateway_reference")
  paidAt           DateTime @map("paid_at")
  createdAt        DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model Reminder {
  id            String    @id @default(uuid())
  invoiceId     String    @map("invoice_id")
  channel       String    @map("channel")
  scheduledAt   DateTime  @map("scheduled_at")
  sentAt        DateTime? @map("sent_at")
  status        String    @default("pending") @map("status")
  failureReason String?   @map("failure_reason")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([scheduledAt, status])
  @@map("reminders")
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  plan             String    @map("plan")
  status           String    @map("status")
  currentPeriodEnd DateTime? @map("current_period_end")
  gatewayCustomerId String?  @map("gateway_customer_id")

  user User @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  action      String   @map("action")
  resourceType String? @map("resource_type")
  resourceId  String? @map("resource_id")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  code      String   @unique
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@map("password_resets")
}

model EmailVerification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verifications")
}
